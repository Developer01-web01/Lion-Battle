rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function admin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  match /admins/{uid} { allow read: if signed() && (request.auth.uid == uid || admin()); allow write: if false; }
  match /users/{uid} {
   allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','phone','uid','referral','email','createdAt']) && request.resource.data.email == request.auth.token.email;
   allow read: if signed() && (request.auth.uid == uid || admin());
   allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
   allow delete: if false;
  }
  match /tournaments/{id} {
   allow read: if signed();
   allow create, delete: if admin();
   allow update: if admin() || (signed() && resource.data.status == 'upcoming' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']) && request.resource.data.players is list && resource.data.players is list && request.resource.data.players.size() == resource.data.players.size()+1 && request.resource.data.players.size() <= resource.data.slots && !(request.auth.uid in resource.data.players) && request.auth.uid in request.resource.data.players && request.resource.data.players.hasAll(resource.data.players));
  }
 }
}
